# Origin of the Spring Boot backend (no trailing /api needed).
VITE_API_BASE_URL=http://localhost:8080

# false = talk to the real backend (default).
# true  = fully mocked demo mode, no backend needed (demo-role buttons appear on /login).
VITE_USE_MOCKS=false

# NEVER put secrets here. Anything starting with VITE_ is public in the built JavaScript.
# The admin bootstrap secret is typed at runtime on /developer/admin-setup.
