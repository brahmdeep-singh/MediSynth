# Copy to .env (git-ignored) and fill in YOUR OWN values. Placeholders only - never commit real values.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/medisynth
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT: Base64 of >= 32 random bytes.  Generate:  openssl rand -base64 48 ---
JWT_SECRET=change-me-base64-of-at-least-32-random-bytes
JWT_EXPIRATION_MS=3600000

# --- CORS: comma-separated exact origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- First-admin bootstrap (developer only) ---
# Leave empty to DISABLE the bootstrap endpoint. When you need it, set a long random value
# (>= 32 chars, e.g. `openssl rand -hex 32`), create the first admin, then remove it again.
ADMIN_BOOTSTRAP_SECRET=

# --- Optional ---
# BCRYPT_STRENGTH=12
# RATE_LIMIT_ENABLED=true

# --- Integration tests use a SEPARATE database (see README) ---
# TEST_DB_URL=jdbc:postgresql://localhost:5432/medisynth_test
# TEST_DB_USERNAME=postgres
# TEST_DB_PASSWORD=change-me
